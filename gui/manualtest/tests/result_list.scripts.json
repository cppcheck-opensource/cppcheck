  "t313463d3": {
    "script": [
      {
        "do": "click",
        "name": "File",
        "role": "menu item",
        "label": "Given the project file is opened from the File menu: open File menu"
      },
      {
        "do": "click",
        "name": "Open Project File...",
        "role": "menu item",
        "label": "Given the project file is opened from the File menu: Open Project File"
      },
      {
        "do": "wait",
        "name": "Select Project File",
        "role": "dialog",
        "label": "Project file dialog is shown"
      },
      {
        "do": "settext",
        "name": "File name:",
        "role": "text",
        "value": "{project:basic-project}/basic.cppcheck",
        "label": "Enter the project file basic.cppcheck"
      },
      {
        "do": "key",
        "keys": [
          "Return"
        ],
        "label": "Open the project file"
      },
      {
        "expect": "visible",
        "name": "Project: basic.cppcheck",
        "role": "frame",
        "timeout": 10,
        "label": "The project is loaded"
      },
      {
        "expect": "visible",
        "name": "src/a.c",
        "role": "table cell",
        "timeout": 30,
        "label": "And the analysis is done: a.c is in the results"
      },
      {
        "expect": "state",
        "name": "Stop analysis",
        "role": "button",
        "not_state": "enabled",
        "timeout": 30,
        "label": "And the analysis is done"
      },
      {
        "do": "focus",
        "name": "src/a.c",
        "role": "table cell",
        "label": "When I expand a.c in the results: select a.c"
      },
      {
        "do": "key",
        "keys": [
          "Right"
        ],
        "label": "When I expand a.c in the results"
      },
      {
        "expect": "visible",
        "name": "Null pointer dereference: p",
        "role": "table cell",
        "label": "The first nullPointer error of a.c is shown"
      },
      {
        "expect": "visible",
        "name": "Null pointer dereference: q",
        "role": "table cell",
        "label": "The second nullPointer error of a.c is shown"
      },
      {
        "do": "rightclick",
        "name": "Null pointer dereference: p",
        "role": "table cell",
        "label": "And I right click on the first nullPointer error"
      },
      {
        "expect": "ocr",
        "contains": "Hide all with id",
        "label": "The context menu has Hide all with id"
      },
      {
        "do": "key",
        "keys": [
          "Up",
          "Up",
          "Up"
        ],
        "label": "Move to Hide all with id in the context menu"
      },
      {
        "do": "key",
        "keys": [
          "Return"
        ],
        "label": "And click Hide all with id"
      },
      {
        "expect": "gone",
        "name": "Null pointer dereference: p",
        "label": "Then the a.c results are hidden: first nullPointer error"
      },
      {
        "expect": "gone",
        "name": "Null pointer dereference: q",
        "label": "Then the a.c results are hidden: second nullPointer error"
      },
      {
        "expect": "visible",
        "name": "Variable 'p' can be declared as pointer to const",
        "role": "table cell",
        "label": "Other a.c results are still shown"
      },
      {
        "do": "click",
        "name": "View",
        "role": "menu item",
        "label": "When I open View menu"
      },
      {
        "do": "click",
        "name": "Show hidden",
        "role": "menu item",
        "label": "When I open View > Show Hidden"
      },
      {
        "expect": "visible",
        "name": "Null pointer dereference: p",
        "role": "table cell",
        "label": "Then the error that was hidden is shown again"
      },
      {
        "expect": "visible",
        "name": "Null pointer dereference: q",
        "role": "table cell",
        "label": "Then the other hidden nullPointer error is shown again"
