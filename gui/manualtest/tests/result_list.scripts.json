  "td7decf1a": {
    "script": [
      {
        "do": "click",
        "name": "File",
        "role": "menu item",
        "label": "Open the File menu"
      },
      {
        "do": "click",
        "name": "Open Project File...",
        "role": "menu item",
        "label": "Choose Open Project File"
      },
      {
        "do": "settext",
        "name": "File name:",
        "role": "text",
        "value": "{project:basic-project}/basic.cppcheck",
        "label": "Enter the project file path"
      },
      {
        "do": "click",
        "name": "Open",
        "role": "button",
        "exact": true,
        "label": "Confirm the file dialog"
      },
      {
        "expect": "visible",
        "name": "src/b.c",
        "role": "table cell",
        "timeout": 30,
        "label": "Analysis is done and results are shown"
      },
      {
        "expect": "visible",
        "name": "src/a.c",
        "role": "table cell",
        "label": "All files are listed before filtering"
      },
      {
        "expect": "visible",
        "name": "include/util.h",
        "role": "table cell",
        "label": "util.h is listed before filtering"
      },
      {
        "do": "focus",
        "path": "0.4.1",
        "role": "text",
        "label": "Focus the Filter field"
      },
      {
        "do": "type",
        "value": "arrayIndex",
        "label": "Type arrayIndex in the Filter field"
      },
      {
        "expect": "visible",
        "name": "src/b.c",
        "role": "table cell",
        "label": "Only the b.c error remains shown"
      },
      {
        "expect": "gone",
        "name": "src/a.c",
        "role": "table cell",
        "label": "a.c error is filtered out"
      },
      {
        "expect": "gone",
        "name": "include/util.h",
        "role": "table cell",
        "label": "util.h error is filtered out"
      },
      {
        "do": "settext",
        "path": "0.4.1",
        "role": "text",
        "value": "",
        "label": "Clear the Filter field"
      },
      {
        "expect": "visible",
        "name": "src/a.c",
        "role": "table cell",
        "label": "a.c error is shown again"
      },
      {
        "expect": "visible",
        "name": "src/b.c",
        "role": "table cell",
        "label": "b.c error is shown again"
      },
      {
        "expect": "visible",
        "name": "include/util.h",
        "role": "table cell",
        "label": "util.h error is shown again"
      }
    ],
    "script_for": "f86b9b8205a7"
  },
  "t2af9d498": {
    "script": [
      {
        "do": "click",
        "name": "File",
        "role": "menu item",
        "label": "Open the File menu"
      },
      {
        "do": "click",
        "name": "Open Project File...",
        "role": "menu item",
        "label": "Choose Open Project File"
      },
      {
        "do": "settext",
        "name": "File name:",
        "role": "text",
        "value": "{project:basic-project}/basic.cppcheck",
        "label": "Enter the project file path"
      },
      {
        "do": "key",
        "keys": [
          "Return"
        ],
        "label": "Confirm the file dialog"
      },
      {
        "do": "wait",
        "name": "Checking src/b.c",
        "role": "list item",
        "timeout": 30,
        "label": "Wait until the analysis has run"
      },
      {
        "expect": "visible",
        "name": "src/a.c",
        "role": "table cell",
        "timeout": 30,
        "label": "Results are shown"
      },
      {
        "do": "click",
        "name": "View",
        "role": "menu item",
        "label": "Open the View menu"
      },
      {
        "do": "click",
        "name": "Collapse all",
        "role": "menu item",
        "label": "View > Collapse All"
      },
      {
        "do": "click",
        "name": "Expand all",
        "role": "menu item",
        "label": "View > Expand All (menu is still open)"
      },
      {
        "expect": "visible",
        "name": "Null pointer dereference: r",
        "role": "table cell",
        "label": "The error in util.h is visible"
      },
      {
        "expect": "visible",
        "name": "Null pointer dereference: p",
        "role": "table cell",
        "label": "The error in a.c is visible"
      },
      {
        "expect": "state",
        "name": "include/util.h",
        "role": "table cell",
        "state": "expanded",
        "nth": 0,
        "label": "util.h is expanded"
      },
      {
        "expect": "state",
        "name": "src/a.c",
        "role": "table cell",
        "state": "expanded",
        "nth": 0,
        "label": "a.c is expanded"
      }
    ],
    "script_for": "3d1da0542440"
  },
