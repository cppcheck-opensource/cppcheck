{
  "tf9fc8bf6": {
    "script": [
      {
        "do": "click",
        "name": "File",
        "role": "menu item",
        "label": "Open the File menu"
      },
      {
        "do": "click",
        "name": "Open Project File...",
        "role": "menu item",
        "label": "Choose Open Project File in the File menu"
      },
      {
        "expect": "visible",
        "name": "Select Project File",
        "role": "dialog",
        "label": "The project file dialog is shown"
      },
      {
        "do": "settext",
        "name": "File name:",
        "role": "text",
        "value": "{project:basic-project}/basic.cppcheck",
        "label": "Enter the path of basic.cppcheck"
      },
      {
        "do": "key",
        "keys": [
          "Return"
        ],
        "label": "Confirm the dialog to open the project"
      },
      {
        "expect": "visible",
        "name": "Project: basic.cppcheck",
        "role": "frame",
        "timeout": 15,
        "label": "The title of the main window names basic.cppcheck"
      },
      {
        "do": "wait",
        "name": "Select Project File",
        "gone": true,
        "label": "The dialog is closed"
      },
      {
        "do": "sleep",
        "seconds": 4,
        "label": "Wait for the analysis to finish"
      },
      {
        "do": "focus",
        "role": "tree",
        "label": "Focus the results tree"
      },
      {
        "do": "key",
        "keys": [
          "Home",
          "Down",
          "Down",
          "Right",
          "Up",
          "Right",
          "Up",
          "Right",
          "Home"
        ],
        "label": "Expand the results of all three files and go to the top"
      },
      {
        "expect": "visible",
        "name": "nullPointer",
        "role": "table cell",
        "timeout": 10,
        "label": "nullPointer errors are shown for util.h and a.c"
      },
      {
        "expect": "text",
        "contains": "src/a.c",
        "label": "Results for a.c are shown"
      },
      {
        "expect": "text",
        "contains": "include/util.h",
        "label": "Results for util.h are shown"
      },
      {
        "do": "key",
        "keys": [
          "End"
        ],
        "label": "Scroll to the results of b.c"
      },
      {
        "expect": "visible",
        "name": "arrayIndexOutOfBounds",
        "role": "table cell",
        "timeout": 10,
        "label": "arrayIndexOutOfBounds error is shown for b.c"
      }
    ],
    "script_for": "7128457516b3"
  },
  "t6bb11424": {
    "script": [
      {
        "do": "click",
        "name": "Open Project File",
        "role": "button",
        "label": "Open the first project"
      },
      {
        "do": "type",
        "value": "{project:switch-project}/one/p1.cppcheck",
        "label": "Enter path of p1.cppcheck"
      },
      {
        "do": "key",
        "keys": [
          "Return"
        ],
        "label": "Confirm the file dialog"
      },
      {
        "expect": "visible",
        "name": "Project: p1.cppcheck",
        "role": "frame",
        "timeout": 10,
        "label": "First project is loaded"
      },
      {
        "expect": "visible",
        "name": "a.c",
        "role": "table cell",
        "timeout": 20,
        "label": "Results of the first project show a.c"
      },
      {
        "do": "click",
        "name": "Open Project File",
        "role": "button",
        "label": "Open the second project"
      },
      {
        "do": "type",
        "value": "{project:switch-project}/two/p2.cppcheck",
        "label": "Enter path of p2.cppcheck"
      },
      {
        "do": "key",
        "keys": [
          "Return"
        ],
        "label": "Confirm the file dialog"
      },
      {
        "expect": "visible",
        "name": "Project: p2.cppcheck",
        "role": "frame",
        "timeout": 10,
        "label": "Second project is loaded"
      },
      {
        "expect": "visible",
        "name": "b.c",
        "role": "table cell",
        "timeout": 20,
        "label": "Results of the second project show b.c"
      },
      {
        "expect": "gone",
        "name": "a.c",
        "role": "table cell",
        "label": "Results of the first project are gone"
      }
    ],
    "script_for": "70097c80a6ed"
  },
