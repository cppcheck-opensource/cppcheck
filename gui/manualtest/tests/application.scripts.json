  "t1cc2be0f": {
    "script": [
      {
        "do": "click",
        "name": "View",
        "role": "menu item",
        "label": "Open View menu"
      },
      {
        "do": "click",
        "name": "Toolbars",
        "role": "menu item",
        "label": "Open Toolbars submenu"
      },
      {
        "expect": "state",
        "name": "Standard",
        "role": "menu item",
        "state": "checked",
        "label": "Standard toolbar entry is checked"
      },
      {
        "expect": "state",
        "name": "Categories",
        "role": "menu item",
        "state": "checked",
        "label": "Categories toolbar entry is checked"
      },
      {
        "expect": "state",
        "name": "Filter",
        "role": "menu item",
        "state": "checked",
        "label": "Filter toolbar entry is checked"
      },
      {
        "do": "click",
        "name": "Standard",
        "role": "menu item",
        "label": "Uncheck Standard toolbar"
      },
      {
        "expect": "gone",
        "name": "Standard",
        "role": "tool bar",
        "label": "Standard toolbar is no longer shown"
      },
      {
        "expect": "visible",
        "name": "Categories",
        "role": "tool bar",
        "label": "Categories toolbar still shown"
      },
      {
        "expect": "visible",
        "name": "Filter",
        "role": "tool bar",
        "label": "Filter toolbar still shown"
      },
      {
        "do": "click",
        "name": "Categories",
        "role": "menu item",
        "label": "Uncheck Categories toolbar"
      },
      {
        "expect": "gone",
        "name": "Categories",
        "role": "tool bar",
        "label": "Categories toolbar is no longer shown"
      },
      {
        "expect": "visible",
        "name": "Filter",
        "role": "tool bar",
        "label": "Filter toolbar still shown"
      },
      {
        "do": "click",
        "name": "Filter",
        "role": "menu item",
        "label": "Uncheck Filter toolbar"
      },
      {
        "expect": "gone",
        "name": "Filter",
        "role": "tool bar",
        "label": "Filter toolbar is no longer shown"
      }
    ],
    "script_for": "6a99d7841493"
  },
  "t5fdeee58": {
    "script": [
      {
        "expect": "capture",
        "name": "Cppcheck",
        "role": "frame",
        "regex": "'Cppcheck (?:Premium )?(\\d[^']*)'",
        "as": "version",
        "label": "Note the version in the title of the main window"
      },
      {
        "do": "click",
        "name": "Help",
        "role": "menu item",
        "label": "Open the Help menu"
      },
      {
        "do": "click",
        "name": "About...",
        "role": "menu item",
        "label": "Open Help > About"
      },
      {
        "expect": "visible",
        "name": "About Cppcheck",
        "role": "dialog",
        "label": "About dialog is shown"
      },
      {
        "expect": "visible",
        "name": "Version {version}",
        "role": "label",
        "label": "About dialog shows the same version as the main window title ({version})"
      }
    ],
    "script_for": "5dadee22b5ec"
  },
  "t90321d9c": {
    "script": [
      {
        "do": "click",
        "name": "Help",
        "role": "menu item",
        "label": "Open the Help menu"
      },
      {
        "do": "click",
        "name": "Contents",
        "role": "menu item",
        "label": "Choose Help > Contents"
      },
      {
        "expect": "visible",
        "name": "Cppcheck GUI help",
        "role": "dialog",
        "label": "A help window opens",
        "observed_fail": true
      },
      {
        "expect": "text",
        "contains": "Contents",
        "label": "The help window has contents (it is not empty)"
      },
      {
        "expect": "text",
