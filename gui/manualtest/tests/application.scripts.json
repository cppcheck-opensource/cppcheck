  "t5bf8f6ae": {
    "script": [
      {
        "do": "click",
        "name": "View",
        "role": "menu item",
        "label": "Open the View menu"
      },
      {
        "do": "click",
        "name": "Show Scratchpad",
        "role": "menu item",
        "label": "Open View > Scratch Pad"
      },
      {
        "expect": "visible",
        "name": "Scratchpad",
        "role": "dialog",
        "label": "Scratchpad dialog is shown"
      },
      {
        "do": "focus",
        "path": "1.1",
        "label": "Focus the code editor of the scratchpad"
      },
      {
        "do": "type",
        "value": "int main(void)",
        "label": "Type line 1"
      },
      {
        "do": "key",
        "keys": [
          "Return"
        ],
        "label": "New line"
      },
      {
        "do": "type",
        "value": "{",
        "label": "Type line 2"
      },
      {
        "do": "key",
        "keys": [
          "Return"
        ],
        "label": "New line"
      },
      {
        "do": "type",
        "value": "    int *p = 0;",
        "label": "Type line 3"
      },
      {
        "do": "key",
        "keys": [
          "Return"
        ],
        "label": "New line"
      },
      {
        "do": "type",
        "value": "    return *p;",
        "label": "Type line 4"
      },
      {
        "do": "key",
        "keys": [
          "Return"
        ],
        "label": "New line"
      },
      {
        "do": "type",
        "value": "}",
        "label": "Type line 5"
      },
      {
        "do": "click",
        "name": "Check",
        "role": "button",
        "label": "Click Check"
      },
      {
        "expect": "text",
        "contains": "nullPointer",
        "timeout": 15,
        "label": "A nullPointer error is shown"
      },
      {
        "expect": "text",
        "contains": "Null pointer dereference: p",
        "label": "The null pointer message is shown"
      },
      {
        "expect": "alive",
        "label": "The application did not crash"
      }
    ],
    "script_for": "30d9d26803fd"
  },
