if(MSVC)
    # Visual Studio only sets _DEBUG
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS $<$<CONFIG:Debug>:DEBUG>)

    list(APPEND CPPCHECK_COMPILE_DEFINITIONS _CRT_SECURE_NO_WARNINGS)
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS WIN32_LEAN_MEAN)
endif()

# libstdc++-specific flags
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU" OR (NOT USE_LIBCXX AND CMAKE_CXX_COMPILER_ID MATCHES "Clang"))
    if(CPPCHK_GLIBCXX_DEBUG AND CMAKE_BUILD_TYPE STREQUAL "Debug")
        list(APPEND CPPCHECK_COMPILE_DEFINITIONS _GLIBCXX_DEBUG)
    endif()
endif()

# TODO: what about clang-cl?
# libc++-specific flags - AppleClang only has libc++
if ((USE_LIBCXX AND CMAKE_CXX_COMPILER_ID MATCHES "Clang") OR CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
    if(CPPCHK_GLIBCXX_DEBUG AND CMAKE_BUILD_TYPE STREQUAL "Debug")
        # TODO: determine proper version for AppleClang - current value is based on the oldest version avaialble in CI
        if((CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 18) OR
           (CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang" AND CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 17))
            list(APPEND CPPCHECK_COMPILE_DEFINITIONS _LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_DEBUG)
        else()
            list(APPEND CPPCHECK_COMPILE_DEFINITIONS _LIBCPP_ENABLE_ASSERTIONS=1)
        endif()
        # TODO: also add _LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS?
    else()
        # TODO: check if this can be enabled again for Clang - also done in Makefile
        list(APPEND CPPCHECK_COMPILE_DEFINITIONS _GLIBCXX_DEBUG)
    endif()

    list(APPEND CPPCHECK_COMPILE_DEFINITIONS _LIBCPP_REMOVE_TRANSITIVE_INCLUDES)
endif()

if(HAVE_RULES)
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS HAVE_RULES)
endif()

if(Boost_FOUND)
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS HAVE_BOOST)
    if(USE_BOOST_INT128)
        list(APPEND CPPCHECK_COMPILE_DEFINITIONS HAVE_BOOST_INT128)
    endif()
endif()

if(ENABLE_CHECK_INTERNAL)
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS CHECK_INTERNAL)
endif()

if(DISALLOW_THREAD_EXECUTOR)
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS DISALLOW_THREAD_EXECUTOR)
endif()

if(DISALLOW_PROCESS_EXECUTOR)
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS DISALLOW_PROCESS_EXECUTOR)
endif()

if(NO_UNIX_SIGNAL_HANDLING)
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS NO_UNIX_SIGNAL_HANDLING)
endif()

if(NO_UNIX_BACKTRACE_SUPPORT)
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS NO_UNIX_BACKTRACE_SUPPORT)
endif()

if(NO_WINDOWS_SEH)
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS NO_WINDOWS_SEH)
endif()

if(NOT MSVC)
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS HAVE_EXECINFO_H=${HAVE_EXECINFO_H})
endif()

if(FILESDIR_DEF)
    file(TO_CMAKE_PATH "${FILESDIR_DEF}" _filesdir)
    list(APPEND CPPCHECK_COMPILE_DEFINITIONS FILESDIR="${_filesdir}")
endif()
