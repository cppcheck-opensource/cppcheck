<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb}</ProjectGuid>
    <RootNamespace>itemmacropathcasebuiltintest</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- MSBuildProjectDirectory is one of the fixed "this file"/"this
       project" properties that is always config-invariant by construction
       (invariantItemPathProperties()) -- but MSBuild property names are
       case-insensitive, so real Visual Studio resolves this reference
       regardless of casing. Referencing it here as all-lowercase
       "msbuildprojectdirectory" is the regression case for
       invariantItemPathProperties() itself needing a case-insensitive
       lookup, not just mConfigInvariantProperties. See
       vcxproj_item_macro_path_case_test.py. -->
  <ItemGroup>
    <ClCompile Include="$(msbuildprojectdirectory)\foo.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
